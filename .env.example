# Copy this file to .env and fill in your values.
# Never commit the .env file — it is listed in .gitignore.

TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated list of chat IDs to broadcast signals to (e.g. a private chat AND a group channel)
TELEGRAM_CHAT_ID=your_chat_id_here

# ---------------------------------------------------------------------------
# Optional — all values below are the defaults and can be omitted.
# ---------------------------------------------------------------------------

# ccxt exchange ID to use (e.g. "binance", "kraken", "coinbase")
# EXCHANGE=coinbase

# Comma-separated list of trading pairs to monitor
# SYMBOLS=BTC/USDT,SOL/USDT

# Candle timeframe used for all indicators (e.g. "1h", "4h", "1d")
# TIMEFRAME=1h

# Optional second timeframe for signal confirmation (leave empty to disable)
# CONFIRM_TIMEFRAME=4h

# Simple Moving Average period for the trend filter
# SMA_PERIOD=200

# RSI calculation period
# RSI_PERIOD=14

# RSI thresholds: BUY fires when RSI < threshold (oversold), SELL when RSI > threshold (overbought)
# RSI_BUY_THRESHOLD=35
# RSI_SELL_THRESHOLD=70

# Set to "true" to require price < SMA for SELL signals (mirrors the BUY trend filter)
# SELL_TREND_FILTER=false

# MACD parameters (fast EMA / slow EMA / signal line periods)
# MACD_FAST=12
# MACD_SLOW=26
# MACD_SIGNAL_PERIOD=9

# Bollinger Bands parameters (rolling period / standard deviation multiplier)
# BB_PERIOD=20
# BB_STD=2.0

# Volume spike detection (rolling average period / multiplier threshold)
# VOLUME_SPIKE_PERIOD=20
# VOLUME_SPIKE_MULTIPLIER=2.0

# Number of candles to look back when detecting RSI/price divergence
# DIVERGENCE_LOOKBACK=14

# One-time price level alerts (leave empty to disable)
# PRICE_ALERT_HIGH=100000
# PRICE_ALERT_LOW=50000

# Rolling ATH proximity alert: set LOOKBACK > 0 to enable
# ATH_LOOKBACK_CANDLES=500
# ATH_PROXIMITY_PCT=5.0

# Alert when a single candle moves more than this % (0 = disabled)
# PRICE_MOVE_PCT_THRESHOLD=5.0

# How often (in seconds) the bot checks for new signals
# POLL_INTERVAL_SECONDS=60

# How often (in hours) the daily summary message is sent
# HEARTBEAT_INTERVAL_HOURS=24

# Minimum gap (in hours) before the same signal type can fire again
# SIGNAL_COOLDOWN_HOURS=4

# Number of consecutive polling errors before triggering the circuit breaker alert
# CIRCUIT_BREAKER_ERRORS=5

# Port to expose a Prometheus /metrics endpoint (0 = disabled)
# Requires: pip install prometheus_client
# PROMETHEUS_PORT=8000

# Path for the SQLite signal history database
# DB_PATH=signals.db

# ---------------------------------------------------------------------------
# Advisor brief (Telegram-only, read-only)
# ---------------------------------------------------------------------------

# Enable a daily advisor-style market brief message
# ADVISOR_BRIEF_ENABLED=true

# Hour of day (UTC) to send the daily advisor brief (0-23). Default: 13
# ADVISOR_BRIEF_HOUR_UTC=13

# Enable weekly brief (sent at ADVISOR_BRIEF_HOUR_UTC on the chosen weekday)
# WEEKLY_BRIEF_ENABLED=true

# Weekday for weekly brief: Mon, Tue, Wed, Thu, Fri, Sat, Sun
# WEEKLY_BRIEF_WEEKDAY=Mon

# ---------------------------------------------------------------------------
# Key Levels & Regime Detection (Feature 2)
# ---------------------------------------------------------------------------

# Number of candles (each side) used to identify swing highs and lows
# SWING_LOOKBACK=20

# Number of SMA candles used to measure slope for regime classification
# REGIME_SLOPE_PERIOD=5

# Minimum hours between repeated key-level break alerts for the same symbol
# KEY_LEVEL_BREAK_COOLDOWN_HOURS=8

# Minimum hours between repeated regime-change alerts for the same symbol
# REGIME_CHANGE_COOLDOWN_HOURS=12

# ---------------------------------------------------------------------------
# Risk & Volatility Alerts (Feature 3)
# ---------------------------------------------------------------------------

# Percentage change in BB width that triggers a volatility expansion/contraction alert
# BB_WIDTH_CHANGE_THRESHOLD=20.0

# Rolling window (candles) for the drawdown-from-high calculation
# DRAWDOWN_WINDOW=168

# Comma-separated drawdown thresholds (%) that trigger drawdown alerts
# DRAWDOWN_ALERT_THRESHOLDS=10,20

# Minimum hours between repeated risk-off composite alerts
# RISK_OFF_COOLDOWN_HOURS=24

# Minimum hours between repeated volatility (BB width) alerts
# VOL_ALERT_COOLDOWN_HOURS=12

# ---------------------------------------------------------------------------
# Signal history / backtest context (Feature 7)
# ---------------------------------------------------------------------------

# Number of past candles used to compute "how rare is this signal?" stat
# SIGNAL_HISTORY_LOOKBACK=200

# ---------------------------------------------------------------------------
# Macro calendar event reminders (Feature 5)
# ---------------------------------------------------------------------------

# Enable upcoming macro event reminders
# MACRO_CALENDAR_ENABLED=true

# Path to the macro calendar JSON file (relative to working directory)
# MACRO_CALENDAR_PATH=data/macro_calendar.json

# How far ahead (hours) to start sending event reminders
# Reminders are sent at this window AND again at 1 h before the event
# MACRO_CALENDAR_LOOKAHEAD_HOURS=24

# ---------------------------------------------------------------------------
# Portfolio-agnostic guidance (Feature 6)
# ---------------------------------------------------------------------------

# Enable a weekly DCA (dollar-cost averaging) reminder message
# DCA_REMINDER_ENABLED=true

# Weekday to send the DCA reminder: Mon, Tue, Wed, Thu, Fri, Sat, Sun
# DCA_REMINDER_WEEKDAY=Mon

# Hour of day (UTC) to send the DCA reminder
# DCA_REMINDER_HOUR_UTC=9

# Enable a weekly rotating risk-management tip message
# RISK_TIP_ENABLED=true

# Weekday to send the risk tip
# RISK_TIP_WEEKDAY=Sun

# Hour of day (UTC) to send the risk tip
# RISK_TIP_HOUR_UTC=10
